# URL pública del sitio
NEXT_PUBLIC_SITE_URL=https://tudominio.cl

# Supabase: obligatorias para agenda, reservas y panel administrador en producción
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_PRIVADA

# Opcional si más adelante usas cliente público de Supabase desde el navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Administración y contacto
# El acceso admin se valida con usuarios definidos en components/AdminGuard.tsx
NEXT_PUBLIC_WHATSAPP_NUMBER=56950257518
CONTACT_EMAIL=correo@ejemplo.cl
CRON_SECRET=CAMBIA_ESTE_SECRETO

# Integraciones preparadas para etapas futuras
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=pendiente
GOOGLE_CLIENT_SECRET=pendiente
GOOGLE_REFRESH_TOKEN=pendiente
PAYMENT_PROVIDER=pendiente
WEBPAY_COMMERCE_CODE=pendiente
WEBPAY_API_KEY=pendiente
MERCADOPAGO_ACCESS_TOKEN=pendiente

# Correos automáticos con Gmail SMTP
# EMAIL_PASS debe ser una contraseña de aplicación de Google, no la clave normal del correo.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=Umbral.corporal@gmail.com
EMAIL_PASS=TU_CONTRASENA_DE_APLICACION_DE_GMAIL
EMAIL_FROM="Umbral Corporal <Umbral.corporal@gmail.com>"
EMAIL_TO=Umbral.corporal@gmail.com
